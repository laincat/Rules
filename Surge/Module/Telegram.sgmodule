#!category = Telegram

[Rule]
# > Telegram DC 5 (新加坡)
IP-ASN,44907,TG-SG,no-resolve
IP-ASN,62014,TG-SG,no-resolve
DOMAIN-SUFFIX,flora.web.telegram.org,TG-SG,extended-matching
# > Telegram DC 1&3 (美国)
DOMAIN-SUFFIX,pluto.web.telegram.org,TG-US,extended-matching
DOMAIN-SUFFIX,aurora.web.telegram.org,TG-US,extended-matching
IP-ASN,59930,TG-US,no-resolve
# > Telegram DC 2 (欧洲)
DOMAIN-SUFFIX,venus.web.telegram.org,TG-EU,extended-matching
DOMAIN-SUFFIX,vesta.web.telegram.org,TG-EU,extended-matching
IP-ASN,62041,TG-EU,no-resolve
IP-ASN,211157,TG-EU,no-resolve
IP-CIDR,5.28.192.0/18,TG-EU,no-resolve
IP-CIDR,109.239.140.0/24,TG-EU,no-resolve
# > MTProto 协议
# PROTOCOL,MTProto,TG-EU
