#!name = Telegram 路由（面板直接切换版）
#!desc = Telegram 分流，在 Surge 主界面面板直接点击切换 DC5/DC1&3/DC2 的出口策略，实时生效。
#!author = laincat ，基于 jpkxt | zhetengsha 修改
#!homepage = https://t.me/jpkxt/11 | https://t.me/zhetengsha/6517
#!category = Telegram

# ========== 定义三个策略组（请务必将“代理/直连”替换为你自己的策略组名） ==========
[Policy]
TG-DC5 = select, Smart, Speed-HK, Speed-SG, Speed-JP, Speed-TW, Speed-US, LB-HK, LB-JP, LB-SG, LB-TW, LB-US
TG-DC13 = select, Smart, Speed-HK, Speed-SG, Speed-JP, Speed-TW, Speed-US, LB-HK, LB-JP, LB-SG, LB-TW, LB-US
TG-DC2 = select, Smart, Speed-HK, Speed-SG, Speed-JP, Speed-TW, Speed-US, LB-HK, LB-JP, LB-SG, LB-TW, LB-US

# ========== 规则引用上述策略组 ==========
[Rule]
# > Telegram DC 5
IP-ASN,44907,TG-DC5,no-resolve
IP-ASN,62014,TG-DC5,no-resolve
DOMAIN-SUFFIX,flora.web.telegram.org,TG-DC5,extended-matching

# > Telegram DC 1&3
DOMAIN-SUFFIX,pluto.web.telegram.org,TG-DC13,extended-matching
DOMAIN-SUFFIX,aurora.web.telegram.org,TG-DC13,extended-matching
IP-ASN,59930,TG-DC13,no-resolve

# > Telegram DC 2
DOMAIN-SUFFIX,venus.web.telegram.org,TG-DC2,extended-matching
DOMAIN-SUFFIX,vesta.web.telegram.org,TG-DC2,extended-matching
IP-ASN,62041,TG-DC2,no-resolve
IP-ASN,211157,TG-DC2,no-resolve
IP-CIDR,5.28.192.0/18,TG-DC2,no-resolve
IP-CIDR,109.239.140.0/24,TG-DC2,no-resolve

# > MTProto 协议
PROTOCOL,MTProto,TG-DC2

# ========== 生成三个面板按钮（直接显示在 Surge 首页） ==========
[Panel]
TG-Panel-DC5 = title="📱 TG DC5 (flora)", style=select, policy=TG-DC5
TG-Panel-DC13 = title="📱 TG DC1&3 (pluto)", style=select, policy=TG-DC13
TG-Panel-DC2 = title="📱 TG DC2 (venus/MTProto)", style=select, policy=TG-DC2
