#!name =🐱 SSID Setting
#!desc = 设置子网覆盖，家庭局域网内使用本地 DNS 服务器
#!author = Laincat
#!homepage = https://github.com/laincat/Rules
#!category = Laincat

[SSID Setting]
TYPE:WIRED dns-server="192.168.0.3", encrypted-dns-server="off"
# SSID:LainCat_EX dns-server="192.168.0.3", encrypted-dns-server="off"
# ROUTER:192.168.0.1 dns-server="192.168.0.3", encrypted-dns-server="off"
